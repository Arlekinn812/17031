:: zhigul {"position":"1150,1450","size":"100,100"}
<div id="engine-puzzle">
  <div class="engine-stage" id="engine-stage">
    <img class="engine-photo" src="https://raw.githubusercontent.com/Arlekinn812/17031/main/images/zhigul.png" alt="Моторный отсек с шестью цветными проводами и шестью гнёздами">
    <div class="instruction-overlay">
  <img
    class="instruction-image"
    src="https://raw.githubusercontent.com/Arlekinn812/17031/main/images/mechanic_note.png"
    alt="Памятка механика"
  >
</div>
    <svg class="engine-lines" id="engine-lines"
         viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid meet"
         aria-label="Соединение проводов и гнёзд">
      <g id="engine-line-paths" aria-hidden="true"></g>
      <g id="engine-hotspots"></g>
    </svg>
  </div>

  <div class="engine-controls">
    <div class="engine-actions">
      <span id="engine-count">Подключено: 0/6</span>
      <span class="engine-message" id="engine-message">Выбери провод, затем гнездо.</span>
      <button type="button" class="engine-button" id="engine-check">ПОДАТЬ ПИТАНИЕ</button>
      <button type="button" class="engine-button" id="engine-reset">СБРОС</button>
      <button type="button" class="engine-button" id="engine-next" hidden>ПРОДОЛЖИТЬ</button>
    </div>
  </div>
</div>

<<script>>
$(document).one(":passagedisplay", function () {
  const root = document.getElementById("engine-puzzle");
  if (!root) return;

  const IMAGE_WIDTH = 1672;
  const IMAGE_HEIGHT = 941;

  // ЗДЕСЬ МЕНЯЙ x и y, если надо подвинуть точки по исходной картинке.
  // x — расстояние от ЛЕВОГО края, y — от ВЕРХНЕГО края, в пикселях.
  const wires = [
    { x: 660,  y: 440, min: 18, max: 24, color: "#df5546", name: "красный" },
    { x: 740,  y: 455, min: 30, max: 36, color: "#f0c349", name: "жёлтый" },
    { x: 847,  y: 486, min: 12, max: 24, color: "#81b675", name: "зелёный" },
    { x: 925,  y: 467, min: 36, max: 42, color: "#5686db", name: "синий" },
    { x: 1032, y: 474, min: 12, max: 18, color: "#e08c4d", name: "оранжевый" },
    { x: 1113, y: 458, min: 24, max: 30, color: "#aa78c6", name: "фиолетовый" }
  ];
  const ports = [
    { x: 1054, y: 610, name: "A", freq: 24 },
    { x: 1121, y: 610, name: "B", freq: 12 },
    { x: 1193, y: 610, name: "C", freq: 42 },
    { x: 1265, y: 610, name: "D", freq: 30 },
    { x: 1337, y: 610, name: "E", freq: 18 },
    { x: 1409, y: 610, name: "F", freq: 36 }
  ];

  const sv = State.variables;
  if (!Array.isArray(sv.engineLinks) ||
      sv.engineLinks.length !== wires.length ||
      sv.engineLinks.some(n => !Number.isInteger(n) || n < -1 || n >= ports.length)) {
    sv.engineLinks = Array(wires.length).fill(-1);
    sv.engineSolved = false;
  }

  const svg = root.querySelector("#engine-lines");
  svg.setAttribute("viewBox", `0 0 ${IMAGE_WIDTH} ${IMAGE_HEIGHT}`);
  const lines = root.querySelector("#engine-line-paths");
  const spots = root.querySelector("#engine-hotspots");
  const count = root.querySelector("#engine-count");
  const msg = root.querySelector("#engine-message");
  const check = root.querySelector("#engine-check");
  const reset = root.querySelector("#engine-reset");
  const next = root.querySelector("#engine-next");
  const NS = "http://www.w3.org/2000/svg";
  let selected = -1;
  const wireButtons = [];
  const portButtons = [];

  function say(text, kind = "") {
    msg.textContent = text;
    msg.className = "engine-message" + (kind ? " " + kind : "");
  }

  function svgEl(name, attrs = {}) {
    const el = document.createElementNS(NS, name);
    for (const [key, value] of Object.entries(attrs)) {
      el.setAttribute(key, String(value));
    }
    return el;
  }

  function hotspot(x, y, label, title, onClick) {
    const group = svgEl("g", {
      class: "engine-contact",
      transform: `translate(${x} ${y})`,
      tabindex: "0",
      role: "button",
      "aria-label": title
    });
    const tooltip = svgEl("title");
    tooltip.textContent = title;
    const hit = svgEl("circle", { class: "engine-hit", cx: 0, cy: 0, r: 33 });
    const face = svgEl("circle", { class: "engine-face", cx: 0, cy: 0, r: 23 });
    const txt = svgEl("text", {
      class: "engine-label", x: 0, y: 1,
      "text-anchor": "middle", "dominant-baseline": "middle"
    });
    txt.textContent = label;
    group.append(tooltip, hit, face, txt);
    group.addEventListener("click", onClick);
    group.addEventListener("keydown", event => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        onClick();
      }
    });
    spots.appendChild(group);
    return group;
  }

  wires.forEach((w, i) => {
    const btn = hotspot(w.x, w.y, String(i + 1),
      `Провод ${i + 1} (${w.name}), ${w.min}–${w.max} Гц`, () => {
        if (sv.engineSolved) return;
        selected = selected === i ? -1 : i;
        say(selected < 0 ? "Выбери провод, затем гнездо." :
          `Выбран провод ${i + 1}: ${w.min}–${w.max} Гц. Теперь выбери гнездо.`);
        render();
      });
    wireButtons.push(btn);
  });

  ports.forEach((p, j) => {
    const btn = hotspot(p.x, p.y, p.name,
      `Гнездо ${p.name}: ${p.freq} Гц`, () => {
        if (sv.engineSolved) return;
        if (selected < 0) {
          say(`Гнездо ${p.name}: ${p.freq} Гц. Сначала выбери провод.`);
          return;
        }
        const links = sv.engineLinks.slice();
        if (links[selected] === j) {
          links[selected] = -1;
        } else {
          const previous = links.indexOf(j);
          if (previous !== -1) links[previous] = -1;
          links[selected] = j;
        }
        sv.engineLinks = links;
        selected = -1;
        say("Контакт изменён. Для проверки подай питание.");
        render();
      });
    portButtons.push(btn);
  });

  function drawCable(d, stroke, width, opacity) {
    const el = svgEl("path", {
      d, stroke, "stroke-width": width,
      "stroke-opacity": opacity, "stroke-linecap": "round", fill: "none"
    });
    lines.appendChild(el);
  }

  function drawLines() {
    lines.replaceChildren();
    sv.engineLinks.forEach((j, i) => {
      if (j < 0) return;
      const w = wires[i], p = ports[j];
      const d = `M ${w.x} ${w.y} C ${w.x + 25} ${w.y + 95}, ${p.x - 30} ${p.y - 95}, ${p.x} ${p.y}`;
      drawCable(d, "#090b0c", 16, 0.9);
      drawCable(d, w.color, 11, 1);
      drawCable(d, "#fff6db", 2, 0.22);
    });
  }

  function render() {
    const links = sv.engineLinks;
    wireButtons.forEach((el, i) => {
      el.classList.toggle("is-selected", i === selected);
      el.classList.toggle("is-occupied", links[i] !== -1);
      el.classList.toggle("is-disabled", Boolean(sv.engineSolved));
      el.setAttribute("aria-disabled", String(Boolean(sv.engineSolved)));
    });
    portButtons.forEach((el, j) => {
      el.classList.toggle("is-occupied", links.includes(j));
      el.classList.toggle("is-disabled", Boolean(sv.engineSolved));
      el.setAttribute("aria-disabled", String(Boolean(sv.engineSolved)));
    });
    const filled = links.filter(j => j >= 0).length;
    count.textContent = `Подключено: ${filled}/6`;
    check.disabled = filled !== 6 || Boolean(sv.engineSolved);
    next.hidden = !sv.engineSolved;
    drawLines();
  }

  check.addEventListener("click", () => {
    const links = sv.engineLinks;
    const valid = links.every(j => j >= 0 && j < ports.length) &&
      new Set(links).size === wires.length &&
      links.every((j, i) => ports[j].freq >= wires[i].min &&
                             ports[j].freq <= wires[i].max);
    if (valid) {
      sv.engineSolved = true;
      say("ВСЕ ЦЕПИ ВОССТАНОВЛЕНЫ. ДВИГАТЕЛЬ ЗАПУЩЕН.", "success");
    } else {
      say("ОШИБКА ПОДКЛЮЧЕНИЯ. ПРОВЕРЬ ЧАСТОТЫ И ПОПРОБУЙ СНОВА.", "error");
    }
    render();
  });

  reset.addEventListener("click", () => {
    sv.engineLinks = Array(wires.length).fill(-1);
    sv.engineSolved = false;
    selected = -1;
    say("Все провода отсоединены.");
    render();
  });

  next.addEventListener("click", () => {
    if (sv.engineSolved) Engine.play("cafe");
  });

  if (sv.engineSolved) say("Все цепи восстановлены.", "success");
  render();
});
<</script>>


:: StoryStylesheet [stylesheet]

/* =========================================
   1. ОСНОВНЫЕ НАСТРОЙКИ SUGARCUBE
   ========================================= */

html, body {
    margin: 0 !important;
    padding: 0 !important;
    background: #000;
    width: 100%;
    min-height: 100%;
}

/* Убираем боковую панель */
#ui-bar,
#ui-bar-toggle {
    display: none !important;
}

/* Убираем стандартные отступы SugarCube */
#story {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    max-width: none !important;
    transform: none !important;
}

#passages,
.passage {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    max-width: none !important;
}


/* =========================================
   2. ОБЫЧНЫЕ КОМИКСЫ
   ========================================= */

.comic-image {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    margin: 0;
    padding: 0;
    border: none;
}


/* =========================================
   3. КНОПКА ПРОДОЛЖЕНИЯ
   ========================================= */

.button-1703 {
    width: min(90vw, 650px);
    aspect-ratio: 4 / 1;
    margin: 25px auto;

    background-image: url("https://raw.githubusercontent.com/Arlekinn812/17031/main/images/button_1703.png");
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;

    display: flex;
    align-items: center;
    justify-content: center;
}

.button-1703 a {
    color: #e8d5b0 !important;
    text-decoration: none !important;

    font-family: Georgia, serif;
    font-size: clamp(16px, 2.2vw, 25px);
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;

    padding: 15px 60px;
    transition: 0.25s;
}

.button-1703 a:hover {
    color: #ffffff !important;
    text-shadow: 0 0 10px #c9a66b;
    transform: scale(1.04);
}


/* =========================================
   4. КАРТИНКА С ЗАГАДКОЙ НА ВЕСЬ ЭКРАН
   ========================================= */

.password-scene {
    position: relative;

    width: 100%;
    height: 100vh;
    height: 100dvh;

    max-width: none;
    margin: 0;
    padding: 0;

    overflow: hidden;
}

.password-image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: fill;

    margin: 0;
    padding: 0;
    border: none;
}


/* =========================================
   5. ПОЛЕ ВВОДА ПАРОЛЯ
   ========================================= */

.password-panel {
    position: absolute;

    /* Положение всего блока */
    top: var(--panel-top, 54%);
    left: var(--panel-left, 76%);
    bottom: auto;

    transform: translate(
        -50%,
        var(--panel-offset-y, -19px)
    );

    /* Размеры */
    width: var(--panel-width, 35%);
    max-width: var(--panel-max-width, none);
    box-sizing: border-box;

    /* Расположение элементов */
    display: grid;
    grid-template-columns:
        minmax(0, 1fr)
        var(--button-width, 120px);

    align-items: center;
    column-gap: var(--panel-gap, 12px);
    row-gap: 8px;

    padding: 0;
    margin: 0;

    background: transparent;
    border: none;
    box-shadow: none;
    z-index: 2;
}


/* Скрытая подпись */
.password-panel label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}


/* =========================================
   6. ПРОЗРАЧНАЯ СТРОКА ВВОДА
   ========================================= */

.password-panel input {
    min-width: 0;
    width: 100%;
    height: var(--input-height, 38px);
    box-sizing: border-box;

    padding: 4px 8px;
    margin: 0;

    transform: translateY(
        var(--input-offset-y, 0px)
    );

    background: transparent !important;
    color: var(--input-color, #29170f) !important;

    border: none !important;
    border-radius: 0;
    box-shadow: none !important;

    font-family: Georgia, serif;
    font-size: var(--input-font-size, 18px);
    outline: none;
}

.password-panel input::placeholder {
    color: rgba(60, 35, 20, 0.55);
}

.password-panel input:focus {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
}


/* =========================================
   7. КНОПКА "ПРОВЕРИТЬ"
   ========================================= */



.password-panel button[type="submit"] {
    width: var(--button-width, 120px);
    min-width: 0;
    height: var(--button-height, 36px);

    box-sizing: border-box;
    padding: 0;
    margin: 0;

    /* Независимое перемещение кнопки */
    transform: translateY(
        var(--button-offset-y, 0px)
    );

    background: var(
        --button-background,
        rgba(70, 40, 25, 0.12)
    );

    color: var(--button-color, #29170f);
    border: 1px solid var(--button-color, #29170f);
    border-radius: 4px;

    font-family: Georgia, serif;
    font-size: var(--button-font-size, 15px);
    white-space: nowrap;

    cursor: pointer;
    justify-self: end;
    align-self: center;
}

.password-panel button[type="submit"]:hover {
    background: var(
        --button-hover-background,
        rgba(70, 40, 25, 0.25)
    );
}

.password-panel button[type="submit"]:disabled {
    opacity: 0.5;
    cursor: default;
}


/* =========================================
   8. СООБЩЕНИЯ О РЕЗУЛЬТАТЕ
   ========================================= */

#password-message {
    grid-column: 1 / -1;

    margin: 0;
    padding: 0;

    text-align: center;
    font-size: 14px;
    text-shadow: 0 1px 3px black;
}

#password-message:empty {
    display: none;
}


/* =========================================
   9. ПЕРЕХОД ПОСЛЕ РЕШЕНИЯ
   ========================================= */

#password-next {
    grid-column: 1 / -1;
    text-align: center;
    margin-top: 8px;
}

#password-next a {
    color: #f2d38a;
    font-weight: bold;
    text-decoration: none;
}

#password-next a:hover {
    color: white;
    text-decoration: underline;
}

/* =========================================
   10. Ссылка поверх картинки
   ========================================= */

.image-link {
    position: absolute;

    top: var(--link-top, 50%);
    left: var(--link-left, 50%);

    transform: translate(-50%, -50%);

    color: var(--link-color, #29170f) !important;
    font-size: var(--link-size, 24px);
    font-family: Georgia, serif;

    text-decoration: none !important;
    white-space: nowrap;
    cursor: pointer;

    z-index: 5;
    transition: 0.2s;
}

.image-link:hover {
    color: var(--link-hover-color, #9b3f21) !important;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.3);
}


/* =========================================
   11. УВЕДОМЛЕНИЕ ОБ ОШИБКЕ ОТПРАВКИ
   ========================================= */

.mail-error-popup {
    position: fixed;
    top: 100px;
    right: 150px;

    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    max-width: 350px;
    padding: 14px 18px;

    background: #f5ddd0;
    color: #693727;

    border: 1px solid #c88f74;
    border-radius: 9px;

    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);

    font-family: Georgia, serif;
    font-size: 16px;

    z-index: 1000;
}

/* Показываем уведомление */
.mail-error-popup.visible {
    display: flex;
}

/* Крестик закрытия */
.mail-error-popup .mail-error-close {
    flex-shrink: 0;

    width: 25px;
    height: 25px;
    padding: 0;
    margin: 0;

    background: transparent;
    color: #693727;
    border: none;
    box-shadow: none;

    font-size: 25px;
    line-height: 1;

    cursor: pointer;
}

.mail-error-popup .mail-error-close:hover {
    color: #b44130;
    background: transparent;
}



/* =========================================
   QR-ПАЗЛ: ФОНОВАЯ КАРТИНКА
   ========================================= */

.qrp-scene {
    position: relative;

    width: 100%;
    height: 100vh;
    height: 100dvh;

    margin: 0;
    padding: 0;

    overflow: hidden;
}

/* Большая картинка на весь экран */
.qrp-background {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: fill;

    margin: 0;
    padding: 0;
    border: none;
}


/* =========================================
   QR-ПАЗЛ: ПОЛОЖЕНИЕ НА КАРТИНКЕ
   ========================================= */

.qrp-overlay {
    position: absolute;

    top: var(--qr-top, 35%);
    left: var(--qr-left, 55%);

    transform: translate(
        -50%,
        var(--qr-offset-y, 0px)
    );

    width: min(
        var(--qr-max-width, 520px),
        max(260px, var(--qr-width, 32%)),
        90vw
    );

    box-sizing: border-box;

    margin: 0;
    padding: 0;

    background: transparent;
    border: none;
    box-shadow: none;

    text-align: center;
    z-index: 5;
}


/* =========================================
   QR-ПАЗЛ: ОБЛАСТЬ СБОРКИ
   ========================================= */


.qrp-board {
    width: 100%;
    aspect-ratio: 1 / 1;

    box-sizing: border-box;
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));

    gap: 0;
    padding: 0;
    margin: 0;

    background: transparent;
    border: none;
    border-radius: 0;
    overflow: hidden;
}


/* =========================================
   QR-ПАЗЛ: ОТДЕЛЬНЫЙ ФРАГМЕНТ
   ========================================= */

.qrp-tile {
    position: relative;

    min-width: 0;
    min-height: 0;

    margin: 0;
    padding: 0;
	background: transparent;

    border: none;
    border-radius: 0;

    overflow: hidden;

    cursor: grab;

    user-select: none;
    -webkit-user-select: none;
}

/* Картинка внутри фрагмента */
.qrp-tile img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: fill;
    image-rendering: pixelated;

    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;

    pointer-events: none;
    user-select: none;
}

/* Наведение на подвижный фрагмент */
.qrp-tile:not(.locked):hover {
    outline: 2px solid #d9a176;
    outline-offset: -2px;
    z-index: 1;
}

/* Выбранный фрагмент */
.qrp-tile.selected {
    outline: 3px solid #d9a176;
    outline-offset: -3px;
    z-index: 2;
}

/* Зафиксированный фрагмент */
.qrp-tile.locked {
    cursor: default;
}

/* =========================================
   QR-ПАЗЛ: ЗАВЕРШЁННАЯ СБОРКА
   ========================================= */

.qrp-board.completed .qrp-tile {
    cursor: default;

    outline: none !important;
    box-shadow: none !important;
    border: none !important;
}

/* Убираем эффекты наведения
   после завершения */
.qrp-board.completed .qrp-tile:hover {
    outline: none !important;
}


/* =========================================
   QR-ПАЗЛ: СТАТУС
   ========================================= */

.qrp-status {
    margin: 10px 0 0;
    padding: 0;

    color: white !important;

    font-family: Georgia, serif;
    font-size: 15px;

    text-align: center;
    text-shadow: 0 1px 4px black;
}


/* =========================================
   QR-ПАЗЛ: КНОПКА ПРОДОЛЖЕНИЯ
   ========================================= */

.qrp-next {
    margin: 12px auto 0;
    padding: 10px 24px;

    background: #d9a176;
    color: #3e291c;

    border: 1px solid #a96b43;
    border-radius: 6px;

    font-family: Georgia, serif;
    font-size: 16px;

    cursor: pointer;
}

.qrp-next:hover {
    background: #e7b78e;
}

.qrp-next[hidden] {
    display: none !important;
}


/* =========================================
   ЭКРАН ВВОДА КОДА
   ========================================= */


.qr-code-screen {
    position: absolute;

    top: var(--screen-top, 30%);
    left: var(--screen-left, 82%);
    width: var(--screen-width, 16%);

    transform: translate(-50%, -50%);
    z-index: 11;

    /* Тёмно-оранжевое стекло */
    background: rgba(74, 31, 5, 0.78);

    border: 2px solid #9e4b15;
    border-radius: 7px;

    box-shadow:
        inset 0 0 12px rgba(255, 115, 20, 0.2),
        0 0 14px rgba(255, 105, 0, 0.25);

    padding: 5px 8px;
    box-sizing: border-box;
}



#qr-code-display {
    display: block;
    width: 100%;
    height: 40px;
    box-sizing: border-box;

    padding: 4px;
    margin: 0;

    background: transparent !important;

    /* Яркие цифры */
    color: #ff9d29 !important;

    border: none !important;
    box-shadow: none !important;
    outline: none !important;

    font-family: monospace;
    font-size: var(--screen-font-size, 24px);
    font-weight: bold;
    letter-spacing: 3px;
    text-align: center;

    /* Эффект свечения лампы */
    text-shadow:
        0 0 3px #ffb347,
        0 0 7px #ff7b00,
        0 0 14px rgba(255, 95, 0, 0.85),
        0 0 24px rgba(255, 75, 0, 0.45);
}

#qr-code-display::placeholder {
    color: rgba(255, 157, 41, 0.45);
    text-shadow: 0 0 7px rgba(255, 110, 0, 0.3);
}


/* Сообщение об ошибке */

#qr-keypad-error {
    position: fixed;

    bottom: 25px;
    right: 25px;
    top: auto;
    left: auto;

    transform: none;

    width: max-content;
    max-width: min(90vw, 320px);

    margin: 0;
    padding: 12px 18px;

    background: rgba(65, 25, 8, 0.92);
    color: #ffae55;

    border: 1px solid #c76b30;
    border-radius: 8px;

    font-family: Georgia, serif;
    font-size: 15px;
    text-align: center;

    box-shadow: 0 0 12px rgba(255, 110, 0, 0.25);

    z-index: 50;
}

#qr-keypad-error:empty {
    display: none;
}


/* =========================================
   НЕВИДИМЫЙ НУМПАД
   ========================================= */

.qr-keypad {
    position: absolute;

    top: var(--keypad-top, 40%);
    left: var(--keypad-left, 82%);

    width: var(--keypad-width, 15%);
    height: var(--keypad-height, 35%);

    transform: translateX(-50%);

    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(4, minmax(0, 1fr));

    gap: 0;

    margin: 0;
    padding: 0;
    border: none;
    background: transparent;

    z-index: 12;
}

/* Прозрачные кликабельные кнопки */
.qr-keypad button {
    display: block;

    width: 100%;
    min-width: 0;
    height: 100%;

    padding: 0;
    margin: 0;

    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    color: transparent !important;
    font-size: 0;

    cursor: pointer;
    appearance: none;
}

/* Никакой подсветки при наведении */
.qr-keypad button:hover,
.qr-keypad button:focus,
.qr-keypad button:active {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
}

/* Ноль по центру последнего ряда */
.qr-keypad button[data-digit="0"] {
    grid-column: 2;
    grid-row: 4;
}


#qr-code-display {
    min-width: 0 !important;
    max-width: 100% !important;
    width: 100% !important;

    box-sizing: border-box;
    overflow: hidden;

    font-size: var(--screen-font-size, 24px);
    letter-spacing: 1px;
    text-align: center;
}


/* Паззл под капотом. Добавить в Story Stylesheet (SugarCube 2). */
#engine-puzzle {
  box-sizing: border-box;
  width: min(100%, 1500px);
  margin: 0 auto;
  color: #f3e7d2;
  font: 15px/1.45 "Courier New", monospace;
}
#engine-puzzle *, #engine-puzzle *::before, #engine-puzzle *::after {
  box-sizing: border-box;
}
#engine-puzzle .engine-stage {
  position: relative;
  width: 100%;
  margin: 0 auto;
  aspect-ratio: 1672 / 941;
  isolation: isolate;
}
#engine-puzzle .engine-photo {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: fill;
  border-radius: 8px;
}
#engine-puzzle .engine-lines {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}
/* Контакты теперь живут внутри SVG с viewBox 1672x941.
   Никаких процентов или отдельных пересчётов при resize. */
#engine-puzzle .engine-lines {
  pointer-events: auto;
}
#engine-puzzle #engine-line-paths {
  pointer-events: none;
}
#engine-puzzle .engine-contact {
  cursor: pointer;
  outline: none;
}
#engine-puzzle .engine-contact .engine-hit {
  fill: transparent;
  stroke: none;
}
#engine-puzzle .engine-contact .engine-face {
  fill: #211b18e6;
  stroke: #e5c389;
  stroke-width: 3;
  filter: drop-shadow(0 0 7px #000);
}
#engine-puzzle .engine-contact .engine-label {
  fill: #fff0d5;
  font: bold 24px "Courier New", monospace;
  user-select: none;
  pointer-events: none;
}
#engine-puzzle .engine-contact:hover .engine-face,
#engine-puzzle .engine-contact:focus .engine-face {
  fill: #8b4c24;
  stroke: #ffbf57;
  stroke-width: 5;
}
#engine-puzzle .engine-contact.is-selected .engine-face {
  fill: #c88124;
  stroke: #fff4b6;
  filter: drop-shadow(0 0 14px #ffa83f);
}
#engine-puzzle .engine-contact.is-occupied .engine-face {
  stroke: #9befa3;
  filter: drop-shadow(0 0 12px #83e68a);
}
#engine-puzzle .engine-contact.is-disabled {
  cursor: default;
}
#engine-puzzle .engine-controls {
  width: min(100%, 1050px);
  margin: 8px auto 14px;
  padding: 10px 14px;
  border: 1px solid #6b5943;
  border-radius: 8px;
  background: #242321ef;
  box-shadow: 0 4px 20px #0008;
}
#engine-puzzle .engine-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}
#engine-puzzle .engine-button {
  padding: 8px 12px;
  border: 1px solid #bb8754;
  border-radius: 5px;
  background: #633b27;
  color: #ffebca;
  font: bold 13px "Courier New", monospace;
  cursor: pointer;
}
#engine-puzzle .engine-button:hover { background: #98552e; }
#engine-puzzle .engine-button:disabled { opacity: 0.45; cursor: not-allowed; }
#engine-puzzle .engine-button[hidden] { display: none; }
#engine-puzzle .engine-message { flex: 1 1 230px; }
#engine-puzzle .engine-message.error { color: #ff9393; }
#engine-puzzle .engine-message.success { color: #a3f3b0; }
#engine-puzzle .engine-instructions {
  width: min(100%, 1050px);
  margin: 0 auto 20px;
  padding: 10px 14px;
  border: 1px solid #79694c;
  border-radius: 7px;
  background: #2d2822;
}
#engine-puzzle .engine-instructions summary {
  color: #f0c58d;
  cursor: pointer;
  font-weight: bold;
}
#engine-puzzle .engine-instructions p { margin: 7px 0; }
#engine-puzzle .engine-specs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
#engine-puzzle .engine-specs strong { color: #f5bf7b; }
#engine-puzzle .engine-specs div { margin: 4px 0; }
@media (max-width: 600px) {
  #engine-puzzle .engine-specs { grid-template-columns: 1fr; }
  #engine-puzzle .engine-controls { font-size: 13px; }
}

.instruction-overlay {
  position: absolute;
  left: 2%;
  top: 47%;
  width: 40%;
  z-index: 4;
  pointer-events: none;
}

.instruction-image {
  display: block;
  width: 100%;
  height: auto;
  filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));
}