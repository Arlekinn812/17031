.button-1703 {
    width:  min(90vw, 650px);
    aspect-ratio: 4 / 1;
    margin: 25px auto;
    background-image: url("https://raw.githubusercontent.com/Arlekinn812/17031/main/images/button_1703.png");
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;

    display: flex;
    align-items: center;
    justify-content: center;
}

.button-1703 a {
    color: #e8d5b0 !important;
    text-decoration: none !important;
    font-family: Georgia, serif;
    font-size: clamp(16px, 2.2vw, 25px);
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
    padding: 15px 60px;
    transition: 0.25s;
}

.button-1703 a:hover {
    color: #ffffff !important;
    text-shadow: 0 0 10px #c9a66b;
    transform: scale(1.04);
}