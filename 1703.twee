       target="_blank"
       rel="noopener noreferrer"
       class="image-link"
       style="
           --link-top: 76.5%;
           --link-left: 52%;
           --link-size: 36px;
           --link-color: #29170f;
       ">
        https://disk.yandex.ru/d/v66_ICTn-39T3w
    </a>

    <!-- Поле ввода с кнопкой -->
    <form id="intro11-form"
          class="password-panel"
          style="
              --panel-top: 58%;
              --panel-left: 54%;
              --panel-width: 52%;

              --input-height: 40px;
              --input-font-size: 36px;
              --input-offset-y: 0px;
              --input-color: #ffffff;

              --button-width: 140px;
              --button-height: 60px;
              --button-offset-y: 0px;
              --button-font-size: 24px;

              --button-background: #32bfcf;
              --button-color: #ffffff;
          ">

        <label for="intro11-input">Введите ответ:</label>

        <input id="intro11-input"
               type="text"
               placeholder="Ваш ответ..."
               autocomplete="off"
               spellcheck="false">

        <button type="submit">Отправить</button>

        <p id="password-message" aria-live="polite"></p>

    </form>

</div>
<</nobr>>

<<done>>

<<script>>
(function () {
    const correctHash =
        "085ed64d972968df7c575dc7ebc105e77df287bdcef537e9b30a099570031b1d";

    const form = document.getElementById("intro11-form");
    const input = document.getElementById("intro11-input");
    const message = document.getElementById("password-message");

    const errorPopup = document.createElement("div");
    errorPopup.className = "mail-error-popup";
    errorPopup.setAttribute("role", "alert");

    errorPopup.innerHTML = `
        <span>Неправильный пароль</span>
        <button type="button"
                class="mail-error-close"
                aria-label="Закрыть уведомление">
            &times;
        </button>
    `;

    form.closest(".password-scene").appendChild(errorPopup);

    // Закрытие уведомления
    errorPopup.querySelector(".mail-error-close")
        .addEventListener("click", function () {
            errorPopup.classList.remove("visible");
        });

    function showError() {
        errorPopup.classList.add("visible");
    }

    // Нормализация ответа
    function normalizeAnswer(text) {
        return text
            .normalize("NFC")
            .toLowerCase()
            .replace(/\s+/g, " ")
            .trim();
    }

    // Вычисление SHA-256
    async function sha256(text) {
        const data = new TextEncoder().encode(text);

        const buffer = await crypto.subtle.digest(
            "SHA-256", data
        );

        return Array.from(new Uint8Array(buffer))
            .map(b => b.toString(16).padStart(2, "0"))
            .join("");
    }

    // Проверка ответа
    form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const answer = normalizeAnswer(input.value);

        if (!answer) {
            showError();
            return;
        }

        if (!window.crypto || !crypto.subtle) {
            message.textContent =
                "Проверка недоступна. Откройте игру через HTTPS.";
            message.style.color = "#a52b2b";
            return;
        }

        try {
            const hash = await sha256(answer);

            if (hash === correctHash) {
                // Запоминаем успешное решение
                State.variables.intro11Solved = true;

                // Сразу переходим на следующий пассаж
                Engine.play("office_cams");
            } else {
                showError();
            }

        } catch (error) {
            message.textContent = "Ошибка проверки ответа.";
            message.style.color = "#a52b2b";
            console.error(error);
        }
    });
})();
<</script>>
<</done>>



