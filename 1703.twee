:: 1st part ans {"position":"525,650","size":"100,100"}
<<nobr>>
<div class="password-scene">

    <img src="https://raw.githubusercontent.com/Arlekinn812/17031/main/images/book.png"
         class="password-image"
         alt="Зашифрованная записка">

    <form id="password-form" class="password-panel">

        <label for="password-input">
            Введите расшифровку:
        </label>

        <input id="password-input"
               type="text"
               placeholder="Ваш ответ..."
               autocomplete="off"
               spellcheck="false">

        <button type="submit">Проверить</button>

        <p id="password-message" aria-live="polite"></p>

        <div id="password-next" style="display:none">
            [[Продолжить ->office]]
        </div>

    </form>
</div>
<</nobr>>

<<done>>
<<script>>
(function () {
    const correctHash =
        "b84be9159e825078c1f7ca73abd6549fe35c2f2f64c891fa32b50fec58fbdc88";

    const form = document.getElementById("password-form");
    const input = document.getElementById("password-input");
    const message = document.getElementById("password-message");
    const next = document.getElementById("password-next");

    async function sha256(text) {
        const data = new TextEncoder().encode(text);

        const buffer = await crypto.subtle.digest(
            "SHA-256", data
        );

        return Array.from(new Uint8Array(buffer))
            .map(b => b.toString(16).padStart(2, "0"))
            .join("");
    }

    function showSuccess() {
        message.textContent = "Верно! Записка расшифрована.";
        message.style.color = "#28643a";
        next.style.display = "block";
        input.disabled = true;
        form.querySelector("button").disabled = true;
    }

    if (State.variables.noteSolved) {
        showSuccess();
    }

    form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const answer = input.value.trim().normalize("NFC");

        if (!answer) {
            message.textContent = "Введите ответ.";
            return;
        }

        if (!window.crypto || !crypto.subtle) {
            message.textContent =
                "Проверка недоступна. Откройте игру через HTTPS.";
            return;
        }

        try {
            const hash = await sha256(answer);

            if (hash === correctHash) {
                State.variables.noteSolved = true;
                showSuccess();
            } else {
                message.textContent = "Неверная расшифровка.";
                message.style.color = "#a52b2b";
            }
        } catch (error) {
            message.textContent = "Ошибка проверки ответа.";
            console.error(error);
        }
    });
})();
<</script>>
<</done>>


