<<script>>
(function () {
    const correctHash =
        "c6612fa04f6e73bc7c006caa7fb46d926a7576bc00239617ed7d27f35d1caf06";

    const form = document.getElementById("intro11-form");
    const input = document.getElementById("intro11-input");
    const message = document.getElementById("password-message");

    const errorPopup = document.createElement("div");
    errorPopup.className = "mail-error-popup";
    errorPopup.setAttribute("role", "alert");

    errorPopup.innerHTML = `
        <span>Ошибка отправки письма</span>
        <button type="button"
                class="mail-error-close"
                aria-label="Закрыть уведомление">
            &times;
        </button>
    `;

    form.closest(".password-scene").appendChild(errorPopup);

    // Закрытие уведомления
    errorPopup.querySelector(".mail-error-close")
        .addEventListener("click", function () {
            errorPopup.classList.remove("visible");
        });

    function showError() {
        errorPopup.classList.add("visible");
    }

    // Нормализация ответа
    function normalizeAnswer(text) {
        return text
            .normalize("NFC")
            .toLowerCase()
            .replace(/\s+/g, " ")
            .trim();
    }

    // Вычисление SHA-256
    async function sha256(text) {
        const data = new TextEncoder().encode(text);

        const buffer = await crypto.subtle.digest(
            "SHA-256", data
        );

        return Array.from(new Uint8Array(buffer))
            .map(b => b.toString(16).padStart(2, "0"))
            .join("");
    }

    // Проверка ответа
    form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const answer = normalizeAnswer(input.value);

        if (!answer) {
            showError();
            return;
        }

        if (!window.crypto || !crypto.subtle) {
            message.textContent =
                "Проверка недоступна. Откройте игру через HTTPS.";
            message.style.color = "#a52b2b";
            return;
        }

        try {
            const hash = await sha256(answer);

            if (hash === correctHash) {
                // Запоминаем успешное решение
                State.variables.intro11Solved = true;

                // Сразу переходим на следующий пассаж
                Engine.play("picture_on_tv");
            } else {
                showError();
            }

        } catch (error) {
            message.textContent = "Ошибка проверки ответа.";
            message.style.color = "#a52b2b";
            console.error(error);
        }
    });
})();
<</script>>
<</done>>



