:: qr_ans {"position":"1075,1025","size":"100,100"}

<<nobr>>
<div id="qr-puzzle" class="qrp-scene"
     style="
         --qr-top: 15%;
         --qr-left: 35%;
         --qr-width: 32%;
         --qr-max-width: 520px;
         --qr-offset-y: 0px;
     ">

    <!-- ==========================
         БОЛЬШАЯ ФОНОВАЯ КАРТИНКА
         ========================== -->

    <img
        src="https://raw.githubusercontent.com/Arlekinn812/17031/main/images/qr_input.png"
        class="qrp-background"
        alt="Головоломка"
    >

    <!-- ==========================
         ПАЗЛ ПОВЕРХ КАРТИНКИ
         ========================== -->

    <div class="qrp-overlay">

        <div id="qr-board" class="qrp-board"></div>

        <p id="qr-status"
           class="qrp-status"
           aria-live="polite"></p>

    </div>


<!-- Экран с введённым кодом -->
<div class="qr-code-screen"
     style="
         --screen-top: 15%;
         --screen-left: 82%;
         --screen-width: 16%;
         --screen-font-size: 24px;
     ">

    <input id="qr-code-display"
           type="text"
           placeholder="--------"
           readonly
           aria-label="Введённый код">

   

</div>

<!-- Невидимые кнопки поверх нарисованного нумпада -->
<div id="qr-keypad"
     class="qr-keypad"
     style="
         --keypad-top: 24%;
         --keypad-left: 82.5%;
         --keypad-width: 13%;
         --keypad-height: 35%;
     ">

    <button type="button" data-digit="1">1</button>
    <button type="button" data-digit="2">2</button>
    <button type="button" data-digit="3">3</button>

    <button type="button" data-digit="4">4</button>
    <button type="button" data-digit="5">5</button>
    <button type="button" data-digit="6">6</button>

    <button type="button" data-digit="7">7</button>
    <button type="button" data-digit="8">8</button>
    <button type="button" data-digit="9">9</button>

    <button type="button" data-digit="0">0</button>

</div>
 <p id="qr-keypad-error" aria-live="polite"></p>
</div>
<</nobr>>

<<done>>
<<script>>
(function () {

    // =====================================
    // 1. ШЕСТЬ ФРАГМЕНТОВ QR-КОДА
    // =====================================

    // Указывай изображения в правильном порядке:
    // 1 2 3
    // 4 5 6

    const images = [
        "https://raw.githubusercontent.com/Arlekinn812/17031/main/images/qr_1.png",
        "https://raw.githubusercontent.com/Arlekinn812/17031/main/images/qr_2.png",
        "https://raw.githubusercontent.com/Arlekinn812/17031/main/images/qr_3.png",
        "https://raw.githubusercontent.com/Arlekinn812/17031/main/images/qr_4.png",
        "https://raw.githubusercontent.com/Arlekinn812/17031/main/images/qr_5.png",
        "https://raw.githubusercontent.com/Arlekinn812/17031/main/images/qr_6.png"
    ];

    // Начальное перемешивание
    const initialOrder = [3, 5, 1, 4, 0, 2];

    const root = document.getElementById("qr-puzzle");
    const board = root.querySelector("#qr-board");
    const status = root.querySelector("#qr-status");
    const next = root.querySelector("#qr-next");

    // =====================================
    // 2. СОХРАНЕНИЕ СОСТОЯНИЯ
    // =====================================

    let order = Array.isArray(State.variables.qrOrder)
        ? [...State.variables.qrOrder]
        : [...initialOrder];

    // Проверяем сохранённую перестановку
    if (
        order.length !== 6 ||
        new Set(order).size !== 6 ||
        !order.every(n =>
            Number.isInteger(n) && n >= 0 && n < 6
        )
    ) {
        order = [...initialOrder];
    }

    // Если пазл уже был собран
    if (State.variables.qrSolved) {
        order = [0, 1, 2, 3, 4, 5];
    }

    let draggingFrom = null;
    let selected = null;

    // =====================================
    // 3. ПРОВЕРКА ПОЛОЖЕНИЙ
    // =====================================

    function isLocked(position) {
        return order[position] === position;
    }

    function isSolved() {
        return order.every(
            (piece, position) => piece === position
        );
    }

    // =====================================
    // 4. ОТРИСОВКА ПАЗЛА
    // =====================================

    function render() {

        board.replaceChildren();

        const solved = isSolved();

        order.forEach((piece, position) => {

            const tile = document.createElement("div");

            tile.className = "qrp-tile";
            tile.dataset.position = position;

            const locked = isLocked(position);

            if (locked) {
                tile.classList.add("locked");
            }

            if (selected === position) {
                tile.classList.add("selected");
            }

            tile.draggable = !locked && !solved;
            tile.tabIndex = locked ? -1 : 0;

            tile.setAttribute("role", "button");

            tile.setAttribute(
                "aria-label",
                "Фрагмент " + (piece + 1) +
                ", позиция " + (position + 1) +
                (locked ? ", закреплён" : "")
            );

            const img = document.createElement("img");

            img.src = images[piece];
            img.alt = "";
            img.draggable = false;

            tile.appendChild(img);
            board.appendChild(tile);
        });

        const correct = order.filter(
            (piece, i) => piece === i
        ).length;
    }

    // =====================================
    // 6. ПЕРЕСТАНОВКА КУСОЧКОВ
    // =====================================

    function swapPieces(from, to) {

        if (
            from === null ||
            to === null ||
            from === to ||
            isLocked(from) ||
            isLocked(to) ||
            isSolved()
        ) {
            return;
        }

        // Меняем местами
        [order[from], order[to]] =
            [order[to], order[from]];

        // Сохраняем прогресс
        State.variables.qrOrder = [...order];

        selected = null;
        render();
    }

    // =====================================
    // 7. DRAG AND DROP
    // =====================================

    board.addEventListener("dragstart", function (event) {

        const tile = event.target.closest(".qrp-tile");

        if (!tile) return;

        const position = Number(tile.dataset.position);

        if (isLocked(position)) {
            event.preventDefault();
            return;
        }

        draggingFrom = position;
        selected = null;

        event.dataTransfer.effectAllowed = "move";

        event.dataTransfer.setData(
            "text/plain",
            String(position)
        );
    });

    board.addEventListener("dragover", function (event) {

        const tile = event.target.closest(".qrp-tile");

        if (!tile) return;

        const position = Number(tile.dataset.position);

        if (
            draggingFrom !== null &&
            !isLocked(position)
        ) {
            event.preventDefault();
            event.dataTransfer.dropEffect = "move";
        }
    });

    board.addEventListener("drop", function (event) {

        event.preventDefault();

        const tile = event.target.closest(".qrp-tile");

        if (!tile || draggingFrom === null) return;

        const target = Number(tile.dataset.position);

        swapPieces(draggingFrom, target);

        draggingFrom = null;
    });

    board.addEventListener("dragend", function () {
        draggingFrom = null;
    });

    // =====================================
    // 8. ПЕРЕСТАНОВКА ПО НАЖАТИЮ
    // =====================================

    // Можно сначала нажать на один
    // кусочек, а потом на другой.

    function selectTile(position) {

        if (isLocked(position) || isSolved()) return;

        if (selected === null) {

            selected = position;
            render();

        } else if (selected === position) {

            selected = null;
            render();

        } else {

            swapPieces(selected, position);
        }
    }

    board.addEventListener("click", function (event) {

        const tile = event.target.closest(".qrp-tile");

        if (!tile) return;

        selectTile(Number(tile.dataset.position));
    });

    board.addEventListener("keydown", function (event) {

        if (
            event.key !== "Enter" &&
            event.key !== " "
        ) {
            return;
        }

        const tile = event.target.closest(".qrp-tile");

        if (!tile) return;

        event.preventDefault();

        selectTile(Number(tile.dataset.position));
    });

    // Запускаем головоломку
    render();

})();
<</script>>
<</done>>


<<done>>
<<script>>
(function () {

    // SHA-256 правильного кода
    const correctHash =
        "ae514be79f5b1f5a458aea3f8502a18c766d8cff8081ff12863b674ae367973e";

    const scene = document.getElementById("qr-puzzle");
    const keypad = scene.querySelector("#qr-keypad");
    const display = scene.querySelector("#qr-code-display");
    const error = scene.querySelector("#qr-keypad-error");

    const CODE_LENGTH = 8;

    let buffer = "";
    let checking = false;

    async function sha256(text) {
        const data = new TextEncoder().encode(text);

        const hashBuffer = await crypto.subtle.digest(
            "SHA-256", data
        );

        return Array.from(new Uint8Array(hashBuffer))
            .map(b => b.toString(16).padStart(2, "0"))
            .join("");
    }

    // Проверка восьмизначного кода
    async function checkCode() {

        checking = true;

        if (!window.crypto || !crypto.subtle) {
            error.textContent =
                "Проверка недоступна. Откройте игру через HTTPS.";
            buffer = "";
            display.value = "";
            checking = false;
            return;
        }

        try {
            const hash = await sha256(buffer);

            if (hash === correctHash) {

                // Сохраняем решение
                State.variables.qrCodeSolved = true;

                // Переходим в следующий пассаж
                Engine.play("freedom");

                return;
            }

            // Неверный пароль
            error.textContent = "Неверный код. Попробуйте снова.";

            // Автоматически очищаем буфер
            buffer = "";
            display.value = "";

        } catch (err) {
            error.textContent = "Ошибка проверки кода.";
            buffer = "";
            display.value = "";
            console.error(err);
        } finally {
            checking = false;
        }
    }

    // Нажатие на цифру
    function pressDigit(digit) {

        if (checking || buffer.length >= CODE_LENGTH) {
            return;
        }

        // Убираем старую ошибку
        error.textContent = "";

        // Добавляем цифру
        buffer += digit;

        // Обновляем экран
        display.value = buffer;

        // Проверяем сразу после восьмой цифры
        if (buffer.length === CODE_LENGTH) {
            checkCode();
        }
    }

    // Обработка нажатий нумпада
    keypad.addEventListener("click", function (event) {

        const button = event.target.closest(
            "button[data-digit]"
        );

        if (!button || !keypad.contains(button)) {
            return;
        }

        pressDigit(button.dataset.digit);
    });

})();
<</script>>
<</done>>




